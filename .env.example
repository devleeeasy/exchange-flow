# Airflow (docker-compose.yml에서 참조)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Connection 비밀번호를 메타DB에 암호화 저장하기 위한 키. 아래로 생성 후 채울 것:
#   docker compose exec airflow-scheduler python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# 한국수출입은행 Open API
# 발급: https://www.koreaexim.go.kr/ir/HPHKIR019M01
EXIM_API_KEY=

# Snowflake (scripts/를 로컬에서 단독 실행할 때 사용.
# Airflow DAG는 Connection "snowflake_default"를 사용하므로 이 값들은
# Admin > Connections UI/CLI에도 동일하게 등록해야 한다)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=EXCHANGEFLOW_WH
SNOWFLAKE_DATABASE=EXCHANGEFLOW
SNOWFLAKE_ROLE=
